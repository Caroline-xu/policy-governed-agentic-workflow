          "Variable": "$.fraud.indicators[0]",
          "IsPresent": true,
          "Next": "T07"
        }
      ],
      "Default": "D08"
    },
    "D08": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.payable.payable_amount",
          "NumericGreaterThan": 5000,
          "Next": "H01"
        }
      ],
      "Default": "N09"
    },
    "H01": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:putItem.waitForTaskToken",
      "Parameters": {
        "TableName": "${AuditTableName}",
        "Item": {
          "case_id": {
            "S.$": "$.case_id"
          },
          "attempt_key": {
            "S.$": "States.Format('{}#H01#token', $$.Execution.Id)"
          },
          "execution_id": {
            "S.$": "$$.Execution.Id"
          },
          "node_id": {
            "S": "H01"
          },
          "task_token": {
            "S.$": "$$.Task.Token"
          }
        }
      },
      "ResultPath": "$.h01",
      "Next": "H01Route",
      "Comment": "Callback pause: execution waits here until an external actor (human adjuster, or the evaluation simulator) calls SendTaskSuccess with {\"decision\": \"APPROVE\"|\"REJECT\"}. The task token is stored in the audit table against the case."
    },
    "H01Route": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.h01.decision",
          "StringEquals": "APPROVE",
          "Next": "N09"
        },
        {
          "Variable": "$.h01.decision",
          "StringEquals": "REJECT",
          "Next": "T08"
        }
      ],
      "Default": "T10",
      "Comment": "Appendix B folds this routing into H01 (APPROVE->N09, REJECT->T08); it is a separate Choice state only because ASL requires it. Any other decision value is a contract error -> T10."
    },
    "N09": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${N09LambdaArn}",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 1,
          "BackoffRate": 2.0
        }
      ],
      "Next": "T09",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
