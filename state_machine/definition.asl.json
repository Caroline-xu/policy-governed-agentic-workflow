{
  "Comment": "STAGE frozen graph (Appendix B) - Policy-Governed Agentic Workflow. MaxAttempts:1 in Retry = 1 retry after the first attempt = max 2 attempts per node (Appendix B default); exhaustion falls to Catch -> T10.",
  "StartAt": "N01",
  "States": {
    "N01": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${N01LambdaArn}",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 1,
          "BackoffRate": 2.0
        }
      ],
      "Next": "D01",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "T10",
          "ResultPath": "$.error"
        }
      ]
    },
    "D01": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.facts.missing_fields[0]",
          "IsPresent": true,
          "Next": "T01"
        }
      ],
      "Default": "N02"
    },
    "N02": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${N02LambdaArn}",
        "Payload.$": "$"
      },
