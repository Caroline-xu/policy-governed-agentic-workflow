      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "T10",
          "ResultPath": "$.error"
        }
      ]
    },
    "D03": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.deadline.timely",
          "BooleanEquals": true,
          "Next": "D04"
        }
      ],
      "Default": "T03"
    },
    "D04": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.facts.claim_type",
          "StringEquals": "TRIP_CANCELLATION",
          "Next": "N04"
        },
        {
          "Variable": "$.facts.claim_type",
          "StringEquals": "BAGGAGE_LOSS",
          "Next": "N05"
        },
        {
          "Variable": "$.facts.claim_type",
          "StringEquals": "MEDICAL_EXPENSE",
          "Next": "N06"
        }
      ],
      "Default": "T10"
    },
    "N04": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${N04LambdaArn}",
        "Payload.$": "$"
      },
