          "MaxAttempts": 1,
          "BackoffRate": 2.0
        }
      ],
      "Next": "D02",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "T10",
          "ResultPath": "$.error"
        }
      ]
    },
    "D02": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.coverage.within_coverage_period",
              "BooleanEquals": true
            },
            {
              "Variable": "$.coverage.benefit_covered",
              "BooleanEquals": true
            }
          ],
          "Next": "N03"
        }
      ],
      "Default": "T02"
    },
    "N03": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${N03LambdaArn}",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
